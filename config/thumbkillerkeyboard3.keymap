
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp GRAVE  &kp N1      &kp N2       &kp N3       &kp N4       &kp N5
                &kp ESC    &kp Q       &kp W        &kp E        &kp R        &kp T
                &lt 6 INT2 &lt 5 A     &kp S        &kp D        &kp F        &kp G
                &kp LGUI   &kp Z       &kp X        &kp C        &kp V        &kp A
                &kp LSHIFT &lt 8 F17  &lt 7 F18    &kp LS(LALT) &none        &none
                &kp LALT   &kp LC(LALT) &kp LC(LSHIFT) &kp LCTRL &none        &none
            >;
        };

        layer_1 {
            bindings = <
                &trans   &kp Q   &kp P   &kp J   &kp F   &kp L
                &trans   &kp M   &kp R   &kp E   &kp C   &kp H
                &trans   &trans  &kp S   &kp G   &kp FSLH &kp N
                &trans   &kp X   &kp Y   &kp Z   &kp D   &trans
                &trans   &trans  &trans  &trans  &none   &none
                &trans   &trans  &trans  &trans  &none   &none
            >;
        };

        layer_2 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_3 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_4 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_5 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_6 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_7 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_8 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_9 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };
    };
};
