
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &studio_unlock  &kp N1      &kp N2       &kp N3       &kp N4       &kp N5
                &kp ESC    &kp Q       &kp W        &kp E        &kp R        &kp T
                &lt 6 INT2 &lt 5 A     &kp S        &kp D        &kp F        &kp G
                &kp LGUI   &kp Z       &kp X        &kp C        &kp V        &kp A
                &kp LSHIFT &lt 8 F17  &lt 7 F18    &kp LS(LALT)
                &kp LALT   &kp LC(LALT) &kp LC(LSHIFT) &kp LCTRL
            >;
            sensor-bindings = <&inc_dec_kp RBKT LBKT>;
        };

        layer_1 {
            bindings = <
                &trans   &kp Q   &kp P   &kp J   &kp F   &kp L
                &trans   &kp M   &kp R   &kp E   &kp C   &kp H
                &trans   &trans  &kp S   &kp G   &kp FSLH &kp N
                &trans   &kp X   &kp Y   &kp Z   &kp D   &trans
                &trans   &trans  &trans  &trans
                &trans   &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4
                &kp N0 &kp N1 &kp N0 &kp N0
            >;
        };

        layer_3 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4
                &kp N0 &kp N1 &kp N0 &kp N0
            >;
        };

        layer_4 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4
                &kp N0 &kp N1 &kp N0 &kp N0
            >;
        };

        layer_5 {
            bindings = <
                &none &none &none &kp MINUS &none &kp KP_NLCK
                &none &none &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MULTIPLY
                &none &none &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_ENTER
                &none &none &kp KP_N1 &kp KP_N2 &kp KP_N3 &none
                &kp BKSP &kp KP_PLUS &kp KP_DOT &kp KP_DIVIDE
                &kp SPACE &kp KP_MINUS &kp KP_N0 &kp INT5
            >;
        };

        layer_6 {
            bindings = <
                &none    &none    &none       &none       &none       &none
                &none    &none    &kp LS(N8)  &kp LS(N9)  &none       &none
                &none    &none    &kp LS(N1)  &kp LS(FSLH) &kp MINUS  &none
                &none    &none    &kp LBKT    &kp RBKT    &kp LS(N2)  &none
                &kp LG(V) &kp DEL &kp LC(I)   &kp F2
                &studio_unlock &kp LG(LS(LC(M))) &none &none
            >;
        };

        layer_7 {
            bindings = <
                &none &none &kp LG(LEFT) &kp LG(UP) &kp LG(RIGHT) &kp LG(DOWN)
                &none &none &kp HOME &kp UP &kp END &kp LG(E)
                &none &none &kp LEFT &kp DOWN &kp RIGHT &kp LG(D)
                &none &none &kp LC(LG(LEFT)) &kp LG(INT2) &kp LC(LG(RIGHT)) &none
                &none &none &none &none
                &none &none &none &none
            >;
        };

        layer_8 {
            bindings = <
                &none &none &kp C_PREV &kp C_PLAY &kp C_NEXT &kp C_FF
                &none &none &kp O &kp I &kp U &kp Y
                &none &kp P &kp L &kp K &kp J &kp H
                &kp SQT &kp SEMI &kp M &kp N &kp B &none
                &kp DOT &kp COMMA &none &none
                &none &none &none &none
            >;
        };

        layer_9 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4
                &kp N0 &kp N1 &kp N0 &kp N0
            >;
        };
    };
};
