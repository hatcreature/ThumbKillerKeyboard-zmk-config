#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * Matrix is 6x6. Physical holes are:
         * row 4, col 5; row 5, cols 4 and 5.
         * These positions are kept as &none.
         */

        default_layer {
            bindings = <
                &kp U      &kp I      &kp O      &kp P      &kp L      &kp K
                &kp N1     &kp Q      &kp W      &kp E      &kp R      &kp T
                &mo 1      &kp A      &kp S      &kp D      &kp F      &kp G
                &kp N2     &kp Z      &kp X      &kp C      &kp V      &kp B
                &kp M      &kp J      &kp L      &kp LCTRL   &kp O      &none
                &kp RSHFT  &kp RALT   &kp D      &kp F      &none      &none
            >;
        };

        /*
         * QMK layer 1 used TG(0) at row 0, col 5.
         * ZMK equivalent is &tog 0.
         * Layers 2-9 in the supplied QMK keymap repeat this numeric layout.
         */
        layer_1 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &tog 0
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_2 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_3 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_4 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_5 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_6 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_7 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_8 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };

        layer_9 {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N7 &kp N8 &kp N9 &kp N0
                &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp RET
                &kp N7 &kp N8 &kp N1 &kp N2 &kp N3 &kp N0
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
                &kp N0 &kp N1 &kp N0 &kp N0 &none  &none
            >;
        };
    };
};
